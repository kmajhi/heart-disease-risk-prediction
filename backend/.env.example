# Copy this file to .env and fill in real values.

# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Google OAuth 2.0 Client ID (Web application) from
# https://console.cloud.google.com/apis/credentials — must match the
# frontend's VITE_GOOGLE_CLIENT_ID. Optional: "Login with Google" is
# disabled until this is set.
GOOGLE_OAUTH_CLIENT_ID=
