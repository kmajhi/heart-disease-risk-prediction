# Copy this file to .env and fill in a real value.

# Google OAuth 2.0 Client ID (Web application) — same value as the
# backend's GOOGLE_OAUTH_CLIENT_ID. Get one at
# https://console.cloud.google.com/apis/credentials (Authorized JavaScript
# origins: http://localhost:5173). Optional: "Login with Google" is
# disabled until this is set.
VITE_GOOGLE_CLIENT_ID=
